# VeriVote AI Service — Environment Configuration
# Copy this file to .env and fill in your values

# Backend URL for internal monitoring data fetch
BACKEND_URL=http://localhost:3005

# Internal API key — must match AI_INTERNAL_KEY in backend/.env
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AI_INTERNAL_KEY=change-this-to-a-random-secret

# Ollama LLM (optional — template responses used as fallback when unavailable)
# Install Ollama from https://ollama.com and run: ollama pull llama3.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60

# Monitoring intervals (seconds)
MONITOR_INTERVAL_SECONDS=60
INTEGRITY_INTERVAL_SECONDS=300
SECURITY_INTERVAL_SECONDS=30
