// ============================================================================
// VeriVote Kenya - Prisma Database Schema
// ============================================================================
// 
// This file defines the database structure using Prisma's schema language.
// It replaces the init.sql file - Prisma will generate and manage the SQL.
//
// Key concepts:
// - model = database table
// - @id = primary key
// - @unique = unique constraint
// - @default = default value
// - @map = rename column in database
// - @@map = rename table in database
// - @relation = foreign key relationship
// ============================================================================

// ----------------------------------------------------------------------------
// GENERATOR BLOCK
// ----------------------------------------------------------------------------
// This tells Prisma to generate a TypeScript/JavaScript client
// After running `npx prisma generate`, you can import types from '@prisma/client'

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------------------------------
// DATASOURCE BLOCK
// ----------------------------------------------------------------------------
// Defines your database connection
// The url reads from your .env file's DATABASE_URL variable

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================
// Enums define a fixed set of allowed values
// They become TypeScript union types AND PostgreSQL enum types

/// User roles for access control
enum UserRole {
  VOTER   // Regular voter (default)
  ADMIN   // IEBC administrator
}

/// Status tracking for voters throughout the election process
/// TypeScript: type VoterStatus = 'REGISTERED' | 'VOTED' | 'REVOTED' | ...
enum VoterStatus {
  PENDING_VERIFICATION  // Voter initiated registration, awaiting Persona ID verification
  PENDING_MANUAL_REVIEW // Automated verification failed, awaiting IEBC physical verification
  REGISTERED            // Voter has completed verification and received SBT
  VERIFICATION_FAILED   // Identity verification rejected (both automated and manual)
  VOTED                 // Voter has successfully cast their vote
  REVOTED               // Voter cast a new vote, replacing their previous one
  DISTRESS_FLAGGED      // Voter used distress PIN - flagged for official review
  SUSPENDED             // Account suspended by administrators
}

/// Status of votes in the system
enum VoteStatus {
  PENDING           // Vote cast but not yet confirmed on blockchain
  CONFIRMED         // Vote successfully recorded on blockchain
  SUPERSEDED        // This vote was replaced by a revote (no longer counts)
  INVALIDATED       // Vote was invalidated (e.g., fraud detection)
}

/// Status of print jobs in the print queue
enum PrintStatus {
  PENDING           // Waiting to be printed
  PRINTING          // Currently being printed
  PRINTED           // Successfully printed
  FAILED            // Print attempt failed
  CANCELLED         // Print job was cancelled
}

/// Preferred channel for PIN delivery to voters
enum PreferredContact {
  SMS
  EMAIL
}

// ── Election system enums ─────────────────────────────────────────────────────

enum ElectionType {
  GOVERNMENT    // National/county/constituency/ward elections
  INSTITUTIONAL // University, NGO, association
  CORPORATE     // Board elections, shareholder vote
  CUSTOM        // Free-form, no geographic scoping
}

enum ElectionStatus {
  DRAFT        // Being configured — not visible to voters
  NOMINATIONS  // Candidates being accepted
  ACTIVE       // Voting open
  CLOSED       // Voting window ended, tally not yet run
  TALLIED      // Ceremony completed, results available
  ARCHIVED     // Permanently closed
}

enum PositionScope {
  NATIONAL        // All voters eligible (e.g. President)
  COUNTY          // Voters whose polling station county === scopeValue
  CONSTITUENCY    // Voters whose polling station constituency === scopeValue
  WARD            // Voters whose polling station ward === scopeValue
  CUSTOM          // Eligibility determined by ElectionEnrollment table
}

/// Identity document type for voter registration
/// Kenya's Elections Act: only National ID and Passport holders are eligible to vote
enum IdDocumentType {
  NATIONAL_ID  // Kenyan National ID (numeric, 5–9 digits)
  PASSPORT     // Kenyan or foreign passport (alphanumeric, 6–12 chars)
}

/// IEBC staff role determining portal access level
enum StaffRole {
  // Commission
  CHAIRPERSON                 // Presidential Returning Officer — highest authority
  COMMISSIONER                // IEBC Commissioner — policy & oversight
  COMMISSION_SECRETARY        // CEO — manages day-to-day operations
  DEPUTY_COMMISSION_SECRETARY // Deputy CEO

  // Secretariat
  DIRECTOR   // Functional director (ICT, Finance, HR, Legal, Voter Reg — see department)
  MANAGER    // Functional manager (see department field)
  NATIONAL_RO   // National Returning Officer (coordinates national results)
  ICT_ADMIN     // ICT systems administrator (technical access)

  // Field offices
  REGIONAL_COORDINATOR   // One of 17 regional coordinators
  COUNTY_RO              // County Election Manager / Returning Officer
  CONSTITUENCY_RO        // Constituency Election Coordinator

  // Polling station (temporary election officials)
  PRESIDING_OFFICER       // Presiding Officer — overall in charge of station
  DEPUTY_PRESIDING_OFFICER // Deputy Presiding Officer
  POLLING_CLERK           // Polling Clerk — voter verification & inking
  SECURITY_OFFICER        // Security Officer — read-only station status

  // Special
  OBSERVER  // Read-only observer (results + audit reports only)
}

/// Administrative level of a staff member's jurisdiction
enum JurisdictionLevel {
  NATIONAL
  COUNTY
  CONSTITUENCY
  WARD
  POLLING_STATION
}

/// Lifecycle status of a formal result declaration
enum DeclarationStatus {
  DRAFT      // Saved but not yet formally declared
  DECLARED   // Formally declared — results are official
  CONTESTED  // Under petition or legal challenge
  ANNULLED   // Nullified by court order
}

// ── Election ──────────────────────────────────────────────────────────────────

model Election {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(255)
  description String?        @db.Text
  type        ElectionType
  status      ElectionStatus @default(DRAFT)
  orgName     String?        @map("org_name") @db.VarChar(255)
  startDate   DateTime?      @map("start_date")
  endDate     DateTime?      @map("end_date")
  tallyResultJson String?    @map("tally_result_json") @db.Text

  // Whether voters must complete KYC (Persona scan) before they can vote.
  // Defaults true for GOVERNMENT elections, false for all others.
  requiresKyc Boolean        @default(false) @map("requires_kyc")

  positions    Position[]
  votes        Vote[]
  enrollments  ElectionEnrollment[]
  declarations ResultDeclaration[]
  jurisdictions ElectionJurisdiction[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@index([status])
  @@index([type])
  @@map("elections")
}

// ── ElectionJurisdiction ──────────────────────────────────────────────────────
// Self-referential tree: each node represents one level of the election's
// geographic or organisational hierarchy.  The root node (parentId = null)
// represents the top-level jurisdiction (e.g. "Kenya" or "Nairobi County").
// Nodes at any depth can hold Positions and Candidates.

model ElectionJurisdiction {
  id         String   @id @default(uuid()) @db.Uuid
  electionId String   @map("election_id") @db.Uuid
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  // Self-referential tree
  parentId String?               @map("parent_id") @db.Uuid
  parent   ElectionJurisdiction? @relation("JurisdictionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ElectionJurisdiction[] @relation("JurisdictionTree")

  name       String             @db.VarChar(255)
  level      JurisdictionLevel?   // NATIONAL | COUNTY | CONSTITUENCY | WARD | POLLING_STATION
  depth      Int                @default(0)
  orderIndex Int                @default(0) @map("order_index")

  // The IEBC officer responsible for this node.
  // They can view results for this node and all descendants,
  // and may declare results for positions attached directly to this node.
  personInChargeId String?    @map("person_in_charge_id") @db.Uuid
  personInCharge   IebcStaff? @relation("JurisdictionInCharge", fields: [personInChargeId], references: [id])

  // For POLLING_STATION-level leaf nodes: link to the physical PollingStation record.
  // Provides geolocation, device counts, and voter-to-station matching.
  pollingStationId String?        @map("polling_station_id") @db.Uuid
  pollingStation   PollingStation? @relation("JurisdictionStation", fields: [pollingStationId], references: [id])

  positions Position[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([electionId])
  @@index([parentId])
  @@index([personInChargeId])
  @@index([pollingStationId])
  @@index([electionId, name])
  @@map("election_jurisdictions")
}

// ── Position ──────────────────────────────────────────────────────────────────

model Position {
  id         String        @id @default(uuid()) @db.Uuid
  electionId String        @map("election_id") @db.Uuid
  election   Election      @relation(fields: [electionId], references: [id], onDelete: Cascade)

  // Optional link to a jurisdiction tree node.
  // When set, this position belongs to that node and all its ancestors in the tree.
  jurisdictionId String?               @map("jurisdiction_id") @db.Uuid
  jurisdiction   ElectionJurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)

  title            String        @db.VarChar(255)
  description      String?       @db.Text
  scope            PositionScope
  // COUNTY: "Nairobi" | CONSTITUENCY: "Westlands" | WARD: "Parklands/Highridge" | CUSTOM: null
  scopeValue       String?       @map("scope_value") @db.VarChar(255)
  maxVotesPerVoter Int           @default(1) @map("max_votes_per_voter")
  orderIndex       Int           @default(0) @map("order_index")

  candidates   Candidate[]
  declarations ResultDeclaration[]

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt      @map("updated_at")

  @@index([electionId])
  @@index([jurisdictionId])
  @@index([scope, scopeValue])
  @@map("positions")
}

// ── Candidate ─────────────────────────────────────────────────────────────────

model Candidate {
  id         String   @id @default(uuid()) @db.Uuid
  positionId String   @map("position_id") @db.Uuid
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  name         String  @db.VarChar(255)
  party        String? @db.VarChar(255)
  description  String? @db.Text
  photoUrl     String? @map("photo_url") @db.VarChar(500)
  ballotNumber Int?    @map("ballot_number")
  isActive     Boolean @default(true) @map("is_active")

  /// Geographic area this candidate represents (county / constituency / ward name).
  /// Used when the parent position is a template (position.scopeValue is null).
  /// The ballot service filters by candidate.scopeValue === voter's matching area.
  scopeValue String? @map("scope_value") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([positionId])
  @@index([positionId, scopeValue])
  @@map("candidates")
}

// ── ElectionEnrollment ────────────────────────────────────────────────────────
// Explicit membership for INSTITUTIONAL and CORPORATE elections.

model ElectionEnrollment {
  id         String   @id @default(uuid()) @db.Uuid
  electionId String   @map("election_id") @db.Uuid
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  voterId    String   @map("voter_id") @db.Uuid

  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([electionId, voterId])
  @@index([electionId])
  @@index([voterId])
  @@map("election_enrollments")
}

// ============================================================================
// VOTER MODEL
// ============================================================================
// Stores registered voter information
// Links national identity to blockchain SBT (Soul-Bound Token)

model Voter {
  // --------------------------------------------------------------------------
  // PRIMARY KEY
  // --------------------------------------------------------------------------
  // Using UUID instead of auto-increment for security
  // - Can't guess other voter IDs
  // - Can generate IDs without database round-trip
  id                String       @id @default(uuid()) @db.Uuid

  // --------------------------------------------------------------------------
  // ROLE
  // --------------------------------------------------------------------------
  role              UserRole     @default(VOTER)

  // --------------------------------------------------------------------------
  // IDENTITY FIELDS
  // --------------------------------------------------------------------------

  // Identity document number — unique per voter regardless of document type
  // @db.VarChar(20) supports IDs, passports, and military/alien IDs
  nationalId        String       @unique @map("national_id") @db.VarChar(20)

  // Type of identity document used for registration
  idDocumentType    IdDocumentType @default(NATIONAL_ID) @map("id_document_type")
  
  // Ethereum wallet address where the voter's SBT is stored
  // Format: 0x followed by 40 hex characters (total 42 chars)
  // Nullable (?) because it's assigned after registration
  sbtAddress        String?      @unique @map("sbt_address") @db.VarChar(66)
  
  // The token ID of the SBT on the blockchain
  sbtTokenId        String?      @map("sbt_token_id") @db.VarChar(78)
  
  // When the SBT was minted on the blockchain
  sbtMintedAt       DateTime?    @map("sbt_minted_at")

  // --------------------------------------------------------------------------
  // AUTHENTICATION
  // --------------------------------------------------------------------------

  // Argon2id hash of the voter's self-chosen password (optional).
  // Voters who only use fingerprint (WebAuthn) will have null here.
  passwordHash          String?           @map("password_hash") @db.VarChar(255)

  // Argon2id hashes of the voter's normal PIN and server-generated distress PIN.
  // normalPin is user-chosen (memorability); distressPin is server-generated
  // (coercion resistance — an attacker watching setup cannot identify which PIN triggers the alert).
  normalPinHash         String?           @map("normal_pin_hash") @db.VarChar(255)
  distressPinHash       String?           @map("distress_pin_hash") @db.VarChar(255)
  pinSetAt              DateTime?         @map("pin_set_at")

  // --------------------------------------------------------------------------
  // WEBAUTHN CREDENTIALS (fingerprint / Face ID / device biometric)
  // --------------------------------------------------------------------------
  webAuthnCredentials WebAuthnCredential[]

  // --------------------------------------------------------------------------
  // STATUS TRACKING
  // --------------------------------------------------------------------------
  
  // --------------------------------------------------------------------------
  // PERSONA IDENTITY VERIFICATION
  // --------------------------------------------------------------------------

  // Contact information for OTP delivery and notifications
  phoneNumber           String?           @map("phone_number") @db.VarChar(20)
  email                 String?           @map("email") @db.VarChar(255)
  preferredContact      PreferredContact? @map("preferred_contact")
  fingerprintHash       String?           @map("fingerprint_hash") @db.VarChar(64)
  fingerprintCapturedAt DateTime?         @map("fingerprint_captured_at")

  // Contact ownership verification (set after voter proves they control the contact)
  phoneVerifiedAt       DateTime?         @map("phone_verified_at")
  emailVerifiedAt       DateTime?         @map("email_verified_at")

  // Persona inquiry ID for identity verification tracking
  personaInquiryId  String?      @unique @map("persona_inquiry_id") @db.VarChar(100)

  // Persona verification status: "created","completed","failed","expired"
  personaStatus     String?      @map("persona_status") @db.VarChar(30)

  // When Persona verification was completed
  personaVerifiedAt DateTime?    @map("persona_verified_at")

  // --------------------------------------------------------------------------
  // MANUAL REVIEW (IEBC Physical Verification)
  // --------------------------------------------------------------------------

  // Why automated verification failed (shown to IEBC reviewer)
  verificationFailureReason String?   @map("verification_failure_reason") @db.Text

  // When manual review was requested
  manualReviewRequestedAt   DateTime? @map("manual_review_requested_at")

  // When IEBC official completed the review
  manualReviewedAt          DateTime? @map("manual_reviewed_at")

  // ID of the IEBC official who reviewed (for audit trail)
  manualReviewedBy          String?   @map("manual_reviewed_by") @db.VarChar(100)

  // Notes from the reviewer (reason for approval/rejection)
  manualReviewNotes         String?   @map("manual_review_notes") @db.Text

  // --------------------------------------------------------------------------
  // PIN RESET
  // --------------------------------------------------------------------------

  // Whether a PIN reset has been requested
  pinResetRequested         Boolean   @default(false) @map("pin_reset_requested")

  // When PIN reset was requested
  pinResetRequestedAt       DateTime? @map("pin_reset_requested_at")

  // Persona inquiry ID for biometric PIN reset verification
  pinResetInquiryId         String?   @map("pin_reset_inquiry_id") @db.VarChar(100)

  // When PINs were last reset
  pinLastResetAt            DateTime? @map("pin_last_reset_at")

  // OTP codes for login and contact verification
  otpCodes                  OtpCode[]

  // Scheduled appointment for manual review
  appointment               ManualReviewAppointment?

  // --------------------------------------------------------------------------
  // STATUS TRACKING
  // --------------------------------------------------------------------------

  // Current status of the voter
  status            VoterStatus  @default(PENDING_VERIFICATION)
  
  // How many times they've voted (for revote tracking)
  // VeriVote allows voters to change their vote - only the last one counts
  voteCount         Int          @default(0) @map("vote_count")
  
  // When they last cast a vote
  lastVotedAt       DateTime?    @map("last_voted_at")

  // The ID of the voter's most recent active vote — used to locate the correct
  // vote to supersede during a revote. Cleared when the vote is superseded.
  lastVoteId        String?      @map("last_vote_id") @db.Uuid

  // --------------------------------------------------------------------------
  // RELATIONSHIPS
  // --------------------------------------------------------------------------

  // Each voter is assigned to one polling station
  // @relation() defines the foreign key relationship
  pollingStationId  String?      @map("polling_station_id") @db.Uuid
  pollingStation    PollingStation? @relation(fields: [pollingStationId], references: [id])
  iebcStaff         IebcStaff?

  // --------------------------------------------------------------------------
  // TIMESTAMPS
  // --------------------------------------------------------------------------
  // Prisma automatically manages these

  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // --------------------------------------------------------------------------
  // INDEXES
  // --------------------------------------------------------------------------
  // Indexes speed up queries on frequently searched columns

  @@index([nationalId])       // Fast lookup by national ID
  @@index([sbtAddress])       // Fast lookup by blockchain address
  @@index([pollingStationId]) // Fast lookup by polling station
  @@index([status])           // Fast filtering by status
  @@index([role])             // Fast filtering by role

  // Rename the table in PostgreSQL to 'voters' (plural, lowercase)
  @@map("voters")
}

// ============================================================================
// MANUAL REVIEW APPOINTMENT MODEL
// ============================================================================
// Scheduling system for IEBC physical verification appointments

model ManualReviewAppointment {
  id                String    @id @default(uuid()) @db.Uuid

  // Time slot details
  scheduledAt       DateTime  @map("scheduled_at")
  durationMinutes   Int       @default(15) @map("duration_minutes")

  // Location
  pollingStationId  String    @map("polling_station_id") @db.Uuid
  pollingStation    PollingStation @relation(fields: [pollingStationId], references: [id])

  // Booking status
  status            AppointmentStatus @default(AVAILABLE)

  // Voter who booked (null if still available)
  voterId           String?   @unique @map("voter_id") @db.Uuid
  voter             Voter?    @relation(fields: [voterId], references: [id])

  // IEBC official assigned to this slot
  assignedOfficerId String?   @map("assigned_officer_id") @db.VarChar(100)
  assignedOfficerName String? @map("assigned_officer_name") @db.VarChar(255)

  // Purpose of the appointment
  purpose           AppointmentPurpose @default(REGISTRATION)

  // Booking metadata
  bookedAt          DateTime? @map("booked_at")
  notes             String?   @db.Text

  // Timestamps
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([pollingStationId])
  @@index([scheduledAt])
  @@index([status])
  @@index([voterId])
  @@map("manual_review_appointments")
}

enum AppointmentStatus {
  AVAILABLE         // Slot is open for booking
  BOOKED            // Voter has booked this slot
  COMPLETED         // Review was completed
  CANCELLED         // Appointment was cancelled
  NO_SHOW           // Voter didn't show up
}

enum AppointmentPurpose {
  REGISTRATION  // Voter identity verification for initial registration
  PIN_RESET     // In-person verification for PIN reset
}

// ============================================================================
// VOTE MODEL
// ============================================================================
// Stores encrypted votes
// IMPORTANT: We never store the actual vote choice - only encrypted hashes!

model Vote {
  // --------------------------------------------------------------------------
  // PRIMARY KEY
  // --------------------------------------------------------------------------
  id                  String       @id @default(uuid()) @db.Uuid

  // --------------------------------------------------------------------------
  // ENCRYPTED VOTE DATA
  // --------------------------------------------------------------------------
  
  // SHA-256 hash of the encrypted vote
  // Used for verification without revealing the vote
  encryptedVoteHash   String       @map("encrypted_vote_hash") @db.VarChar(255)
  
  // The actual encrypted vote data (using homomorphic encryption)
  // This allows tallying without decrypting individual votes
  // @db.Text = unlimited length string in PostgreSQL
  encryptedVoteData   String?      @map("encrypted_vote_data") @db.Text

  // Per-candidate exponential ElGamal encoding for homomorphic tallying.
  // Stores E(g^1) for the chosen candidate, E(g^0) for all others.
  // Aggregating these across all votes gives E(g^count) per candidate —
  // decryptable with a threshold of IEBC commissioner key shares.
  homomorphicBallot   String?      @map("homomorphic_ballot") @db.Text

  // --------------------------------------------------------------------------
  // VERIFICATION
  // --------------------------------------------------------------------------
  
  // Unique serial number given to voter as receipt
  // They can use this to verify their vote was counted
  serialNumber        String       @unique @map("serial_number") @db.VarChar(64)
  
  // Zero-Knowledge Proof that the vote is valid
  // Proves the vote is properly formed without revealing the choice
  zkpProof            String?      @map("zkp_proof") @db.Text

  // --------------------------------------------------------------------------
  // BLOCKCHAIN ANCHORING
  // --------------------------------------------------------------------------
  // We record votes on Polygon blockchain for immutability
  
  // The transaction hash on the blockchain
  // Format: 0x followed by 64 hex characters (total 66 chars)
  blockchainTxHash    String?      @map("blockchain_tx_hash") @db.VarChar(66)
  
  // Which block contains this transaction
  blockNumber         BigInt?      @map("block_number")
  
  // When the blockchain confirmed this vote
  confirmedAt         DateTime?    @map("confirmed_at")

  // --------------------------------------------------------------------------
  // DISTRESS FLAG
  // --------------------------------------------------------------------------
  // Set to true when the vote was cast using the voter's distress PIN.
  // Signals that the voter may have been coerced; requires IEBC investigation.
  isDistressFlagged   Boolean      @default(false) @map("is_distress_flagged")

  // --------------------------------------------------------------------------
  // STATUS
  // --------------------------------------------------------------------------
  status              VoteStatus   @default(PENDING)

  // --------------------------------------------------------------------------
  // RELATIONSHIPS
  // --------------------------------------------------------------------------
  
  // Which election this vote belongs to (null for legacy votes)
  electionId          String?      @map("election_id") @db.Uuid
  election            Election?    @relation(fields: [electionId], references: [id])

  // Which polling station this vote was cast at
  // Note: We link to station, NOT to voter (for anonymity!)
  pollingStationId    String       @map("polling_station_id") @db.Uuid
  pollingStation      PollingStation @relation(fields: [pollingStationId], references: [id])
  
  // Link to print queue (one vote can have one print job)
  printQueue          PrintQueue?

  // --------------------------------------------------------------------------
  // REVOTE TRACKING
  // --------------------------------------------------------------------------
  // If this is a revote, link to the previous vote it replaces
  
  previousVoteId      String?      @unique @map("previous_vote_id") @db.Uuid
  previousVote        Vote?        @relation("VoteRevote", fields: [previousVoteId], references: [id])
  supersededBy        Vote?        @relation("VoteRevote")

  // --------------------------------------------------------------------------
  // TIMESTAMPS
  // --------------------------------------------------------------------------
  timestamp           DateTime     @default(now())  // When vote was cast
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  // --------------------------------------------------------------------------
  // INDEXES
  // --------------------------------------------------------------------------
  @@index([serialNumber])       // Fast receipt verification
  @@index([pollingStationId])   // Fast station-based queries
  @@index([electionId])         // Fast election-based queries
  @@index([status])             // Fast status filtering
  @@index([timestamp])          // Fast time-based queries
  @@index([blockchainTxHash])   // Fast blockchain lookup
  
  @@map("votes")
}

// ============================================================================
// POLLING STATION MODEL
// ============================================================================
// Kenya has ~46,000 polling stations
// Administrative hierarchy: County > Constituency > Ward > Polling Station

model PollingStation {
  // --------------------------------------------------------------------------
  // PRIMARY KEY
  // --------------------------------------------------------------------------
  id              String    @id @default(uuid()) @db.Uuid

  // --------------------------------------------------------------------------
  // IDENTIFICATION
  // --------------------------------------------------------------------------
  
  // Unique code like "NAI-WL-001" (County-Constituency-Number)
  code            String    @unique @db.VarChar(20)
  
  // Human-readable name like "Westlands Primary School"
  name            String    @db.VarChar(255)

  // --------------------------------------------------------------------------
  // KENYA ADMINISTRATIVE DIVISIONS
  // --------------------------------------------------------------------------
  // Kenya has 47 counties, 290 constituencies, ~1,450 wards
  
  county          String    @db.VarChar(100)  // e.g., "Nairobi"
  constituency    String    @db.VarChar(100)  // e.g., "Westlands"
  ward            String    @db.VarChar(100)  // e.g., "Parklands/Highridge"

  // --------------------------------------------------------------------------
  // GEOLOCATION
  // --------------------------------------------------------------------------
  // For mapping and finding nearest polling station
  
  latitude        Decimal?  @db.Decimal(10, 8)  // e.g., -1.26345678
  longitude       Decimal?  @db.Decimal(11, 8)  // e.g., 36.80456789
  address         String?   @db.Text

  // --------------------------------------------------------------------------
  // DIASPORA FIELDS
  // --------------------------------------------------------------------------

  // True for Kenyan embassy / high-commission voting stations abroad
  isDiaspora      Boolean   @default(false) @map("is_diaspora")

  // Country where a diaspora station is located (null for domestic stations)
  country         String?   @db.VarChar(100)

  // --------------------------------------------------------------------------
  // CAPACITY & STATUS
  // --------------------------------------------------------------------------

  // How many voters are registered at this station
  registeredVoters Int      @default(0) @map("registered_voters")

  // Is this station currently active?
  isActive        Boolean   @default(true) @map("is_active")
  
  // Operating hours on election day
  openingTime     DateTime? @map("opening_time")
  closingTime     DateTime? @map("closing_time")

  // --------------------------------------------------------------------------
  // EQUIPMENT TRACKING
  // --------------------------------------------------------------------------
  
  // Number of voting devices at this station
  deviceCount     Int       @default(0) @map("device_count")
  
  // Number of printers (for paper ballot backup)
  printerCount    Int       @default(0) @map("printer_count")

  // --------------------------------------------------------------------------
  // TIMESTAMPS
  // --------------------------------------------------------------------------
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // --------------------------------------------------------------------------
  // RELATIONSHIPS
  // --------------------------------------------------------------------------
  // One station has many voters and many votes

  voters          Voter[]
  votes           Vote[]
  printQueue      PrintQueue[]
  manualReviewAppointments ManualReviewAppointment[]
  iebcStaff       IebcStaff[]
  // Jurisdiction tree leaf nodes that represent this physical station
  jurisdictionNodes ElectionJurisdiction[] @relation("JurisdictionStation")

  // --------------------------------------------------------------------------
  // INDEXES
  // --------------------------------------------------------------------------
  @@index([code])
  @@index([county])
  @@index([constituency])
  @@index([ward])
  @@index([isActive])

  @@map("polling_stations")
}

// ── IebcStaff ─────────────────────────────────────────────────────────────────
// Links an ADMIN-role voter to their IEBC staff role and jurisdiction.
// A staff member authenticates through the Voter flow (password + OTP),
// then their IebcStaff record determines what they can access in the portal.

model IebcStaff {
  id                String            @id @default(uuid()) @db.Uuid

  // The voter account used to authenticate (1-to-1)
  voterId           String            @unique @map("voter_id") @db.Uuid
  voter             Voter             @relation(fields: [voterId], references: [id])

  staffRole         StaffRole         @map("staff_role")
  jurisdictionLevel JurisdictionLevel @map("jurisdiction_level")
  // County name, constituency name, ward name, station code — null for NATIONAL
  jurisdictionValue String?           @map("jurisdiction_value") @db.VarChar(255)
  // Functional department for DIRECTOR / MANAGER roles (e.g. "ICT", "Finance", "HR")
  department        String?           @map("department") @db.VarChar(100)

  // For PRESIDING_OFFICER: direct link to their polling station
  pollingStationId  String?           @map("polling_station_id") @db.Uuid
  pollingStation    PollingStation?   @relation(fields: [pollingStationId], references: [id])

  isActive          Boolean           @default(true) @map("is_active")

  // Audit trail: who created this staff record
  createdByStaffId  String?           @map("created_by_staff_id") @db.Uuid
  createdByStaff    IebcStaff?        @relation("StaffHierarchy", fields: [createdByStaffId], references: [id])
  staffCreated      IebcStaff[]       @relation("StaffHierarchy")

  // Jurisdiction nodes where this staff member is the person in charge
  jurisdictionsInCharge ElectionJurisdiction[] @relation("JurisdictionInCharge")

  declarations      ResultDeclaration[]

  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt      @map("updated_at")

  @@index([staffRole])
  @@index([jurisdictionLevel, jurisdictionValue])
  @@map("iebc_staff")
}

// ── ResultDeclaration ─────────────────────────────────────────────────────────
// Records the formal act of a Returning Officer officially declaring results
// for a specific position in a specific election.

model ResultDeclaration {
  id                String            @id @default(uuid()) @db.Uuid

  electionId        String            @map("election_id") @db.Uuid
  election          Election          @relation(fields: [electionId], references: [id])

  positionId        String            @map("position_id") @db.Uuid
  position          Position          @relation(fields: [positionId], references: [id])

  staffId           String            @map("staff_id") @db.Uuid
  staff             IebcStaff         @relation(fields: [staffId], references: [id])

  status            DeclarationStatus @default(DRAFT)

  // Jurisdiction at the time of declaration (snapshot)
  jurisdictionLevel JurisdictionLevel @map("jurisdiction_level")
  jurisdictionValue String?           @map("jurisdiction_value") @db.VarChar(255)

  // JSON snapshot of vote tallies at declaration time
  tallySnapshot     String?           @map("tally_snapshot") @db.Text

  declaredAt        DateTime?         @map("declared_at")
  contestedAt       DateTime?         @map("contested_at")
  contestReason     String?           @map("contest_reason") @db.Text

  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt      @map("updated_at")

  // One officer can only declare each position once per election
  @@unique([electionId, positionId, staffId])
  @@index([electionId])
  @@index([positionId])
  @@index([staffId])
  @@index([status])
  @@map("result_declarations")
}

// ============================================================================
// PRINT QUEUE MODEL
// ============================================================================
// For the centralized vote printing system
// Prints paper ballots as backup/audit trail after election

model PrintQueue {
  // --------------------------------------------------------------------------
  // PRIMARY KEY
  // --------------------------------------------------------------------------
  id                String       @id @default(uuid()) @db.Uuid

  // --------------------------------------------------------------------------
  // RELATIONSHIPS
  // --------------------------------------------------------------------------
  
  // Which vote to print (one print job per vote)
  voteId            String       @unique @map("vote_id") @db.Uuid
  vote              Vote         @relation(fields: [voteId], references: [id])
  
  // Where to print it
  pollingStationId  String       @map("polling_station_id") @db.Uuid
  pollingStation    PollingStation @relation(fields: [pollingStationId], references: [id])

  // --------------------------------------------------------------------------
  // PRINT JOB STATUS
  // --------------------------------------------------------------------------
  
  status            PrintStatus  @default(PENDING)
  priority          Int          @default(0)  // Higher number = more urgent

  // --------------------------------------------------------------------------
  // PRINT TRACKING
  // --------------------------------------------------------------------------
  
  // Which printer handled this job
  printerId         String?      @map("printer_id") @db.VarChar(100)
  
  // When it was printed
  printedAt         DateTime?    @map("printed_at")
  
  // How many times we tried to print
  printAttempts     Int          @default(0) @map("print_attempts")
  
  // Error message if print failed
  lastError         String?      @map("last_error") @db.Text

  // --------------------------------------------------------------------------
  // BALLOT DETAILS
  // --------------------------------------------------------------------------
  
  // Physical ballot paper number
  ballotNumber      String?      @unique @map("ballot_number") @db.VarChar(50)
  
  // QR code data for ballot verification
  qrCodeData        String?      @map("qr_code_data") @db.Text

  // --------------------------------------------------------------------------
  // TIMESTAMPS
  // --------------------------------------------------------------------------
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // --------------------------------------------------------------------------
  // INDEXES
  // --------------------------------------------------------------------------
  @@index([status])
  @@index([pollingStationId])
  @@index([priority])
  @@index([printerId])
  
  @@map("print_queue")
}

// ============================================================================
// WEBAUTHN CREDENTIAL MODEL
// ============================================================================
// Stores public-key credentials enrolled via device biometrics (fingerprint,
// Face ID, etc.) using the WebAuthn / FIDO2 standard.
// The private key never leaves the voter's device — only the public key is
// stored here, alongside a monotonic counter used to detect replay attacks.

model WebAuthnCredential {
  id           String   @id @default(uuid()) @db.Uuid

  // Foreign key to the voter who owns this credential
  voterId      String   @map("voter_id") @db.Uuid
  voter        Voter    @relation(fields: [voterId], references: [id])

  // Base64URL credential ID produced by the authenticator (unique per device)
  credentialId String   @unique @map("credential_id") @db.Text

  // COSE-encoded public key (binary, ~77-300 bytes depending on algorithm)
  publicKey    Bytes    @map("public_key")

  // Monotonically-increasing usage counter for replay-attack detection
  counter      BigInt   @default(0)

  // "singleDevice" or "multiDevice" (passkey)
  deviceType   String   @map("device_type") @db.VarChar(32)

  // Whether a multi-device credential has been backed up to the cloud
  backedUp     Boolean  @default(false) @map("backed_up")

  // JSON-encoded array of transport hints (e.g. ["internal", "hybrid"])
  transports   String?  @db.Text

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([voterId])
  @@map("webauthn_credentials")
}

// ============================================================================
// OTP CODE MODEL
// ============================================================================
// Short-lived one-time passwords for login and contact verification.
// Only the SHA-256 hash of the code is stored — never the plaintext.
// Each code is single-use: usedAt is set on first successful (or exhausted) use.

model OtpCode {
  id        String    @id @default(uuid()) @db.Uuid

  voterId   String    @map("voter_id") @db.Uuid
  voter     Voter     @relation(fields: [voterId], references: [id], onDelete: Cascade)

  // "LOGIN" | "CONTACT_VERIFY" | "CREDENTIAL_RESET"
  purpose   String    @db.VarChar(32)

  // SHA-256 hex of the plaintext 6-digit code — never store plaintext
  codeHash  String    @map("code_hash") @db.VarChar(64)

  expiresAt DateTime  @map("expires_at")

  // Number of failed verify attempts; invalidated when attempts > 3
  attempts  Int       @default(0)

  // Set when the code is consumed (success or max-attempts reached)
  usedAt    DateTime? @map("used_at")

  createdAt DateTime  @default(now()) @map("created_at")

  @@index([voterId, purpose])
  @@map("otp_codes")
}
